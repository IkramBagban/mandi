{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Global @types only for what the app + tests use: `node` (process.env)
    // and `jest` (describe/it/expect in tests/). Listing them explicitly also
    // works around @types/jest not being auto-included under this base config.
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
