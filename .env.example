# Copy to `.env` (never commit `.env` — it is gitignored).
# Get these from your Supabase project: Dashboard → Project Settings → API.
# UI work does NOT need real values; repositories are stubs until then.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OTP code flows (Login OTP tab, signup/recovery verify). DEFAULT OFF —
# leave unset or 'false' for password-only auth (zero SMS). Set to 'true'
# only with phone confirmations ON in the dashboard + the MSG91 hook live
# (see README "Auth"). Changing this needs an app rebuild (dev: restart
# `npx expo start`).
# EXPO_PUBLIC_OTP_ENABLED=false
